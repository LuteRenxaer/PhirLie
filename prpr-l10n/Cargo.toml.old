[package]
name = "prpr-l10n"
version = "1.2.0"
edition = "2021"
license = "GPL-3.0-only"
description = "PRPR L10n"

[dependencies]
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.149"
fluent = "0.17.0"
fluent-syntax = "0.12.0"
unic-langid = { version = "0.9.6", features = ["unic-langid-macros"] }
once_cell = "1.21.4"
tracing = "0.1.44"
lru = "0.16.3"
walkdir = "2.5.0"
sys-locale = "0.3.2"
thiserror = "1.0"
