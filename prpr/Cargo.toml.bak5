[package]
name = "prpr"
version = "1.2.0"
edition = "2021"
license = "GPL-3.0-only"
description = "Phire Music Game"

[lib]
crate-type = ["cdylib", "rlib"]

[features]
default = ["log"]
video = ["prpr-avc"]
log = ["tracing-subscriber", "colored"]

[dependencies]
anyhow = "1.0"
async-trait = "0.1.89"
base64 = "0.22.1"
bitflags = { version = "2.11.0", features = ["serde"] }
byteorder = "1.5.0"
cfg-if = "1.0.4"
chardetng = "0.1.17"
chrono = { version = "0.4.44", features = ["serde"] }
colored = { version = "3.1.1", optional = true }
concat-string = "1.0.1"
glyph_brush = "0.7.12"
image = { version = "0.25.10", default-features = false, features = ["png", "jpeg", "gif", "bmp"] }
inputbox = "0.1.4"
lyon = "1.0.19"
nalgebra = "0.34.1"
once_cell = "1.21.4"
ordered-float = "5.1.0"
phf = { version = "0.13.1", features = ["macros"] }
rand = "0.8.5"
regex = "1.12.3"
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.149"
serde_yaml = "0.9.34"
tokio = { version = "1.50.0", features = ["rt-multi-thread", "fs"] }
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.23", features = ["env-filter"], optional = true }
uuid = { version = "1.22.0", features = ["v4"] }
walkdir = "2.5.0"
zip = { version = "8.3.0", default-features = false, features = ["deflate"] }

macroquad = { git = "https://github.com/Mivik/prpr-macroquad", rev = "b2eab29", default-features = false }
miniquad = { git = "https://github.com/Mivik/prpr-miniquad", rev = "0c525a3" }
sasa = { git = "https://github.com/Mivik/sasa", rev = "e76229b", default-features = false }

prpr-avc = { path = "../prpr-avc", optional = true }
prpr-l10n = { path = "../prpr-l10n" }

[target.'cfg(target_os = "android")'.dependencies]
jni = "0.22.4"
ndk-context = "0.1"

[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
tokio = { version = "1.50.0", features = ["rt-multi-thread", "fs"] }

[target.'cfg(target_arch = "wasm32")'.dependencies]
web-sys = { version = "0.3", features = ["Location", "Performance", "UrlSearchParams", "Window"] }
js-sys = "*"
wasm-bindgen = "*"
wasm-bindgen-futures = "0.4"

[build-dependencies]
walkdir = "2.5.0"

[dev-dependencies]
walkdir = "2.5.0"

["../assets"]   # 如果你资源在根目录的 assets 文件夹
# 或者如果资源在 prpr 目录下，则 assets = ["./assets"]

["../assets"]
[package.metadata.android]
apk_name = "Phire"
package_name = "com.lute.phire"
assets = "../assets"