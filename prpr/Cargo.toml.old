[package]
name = "prpr"
version = "1.2.0"
edition = "2021"
license = "GPL-3.0-only"
description = "Phire Music Game"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
anyhow = "1.0"
async-trait = "0.1.89"
base64 = "0.22.1"
bitflags = "2.11.0"
chrono = "0.4.44"
image = { version = "0.25.10", default-features = false, features = ["png", "jpeg"] }
once_cell = "1.21.4"
rand = "0.8.5"
regex = "1.12.3"
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.149"
serde_yaml = "0.9.34"
tokio = { version = "1.50.0", features = ["rt-multi-thread", "fs"] }
tracing = "0.1.44"
uuid = { version = "1.22.0", features = ["v4"] }
walkdir = "2.5.0"
tracing-subscriber = { version = "0.3.23", features = ["env-filter"] }
colored = "3.1.1"
macroquad = { git = "https://github.com/Mivik/prpr-macroquad", rev = "b2eab29", default-features = false }
miniquad = { git = "https://github.com/Mivik/prpr-miniquad", rev = "0c525a3" }
sasa = { git = "https://github.com/Mivik/sasa", rev = "e76229b", default-features = false }

[target.'cfg(target_os = "android")'.dependencies]
jni = "0.22.4"
ndk-context = "0.1"
